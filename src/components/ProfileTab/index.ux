  flex: 1;
  font-size: 30px;
  color: #4a3728;
  margin-left: 16px;
}

.menu-arrow {
  font-size: 36px;
  color: #c9b8ad;
}

/* ========== 用户面板（底部弹出） ========== */
.panel-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
}

