<template>
  <div class="profile-tab">
    <!-- 头部用户信息 -->
    <div class="header">
      <div class="user-card" onclick="showUserPanel">
        <div class="avatar">
          <text class="avatar-text">{{ avatarChar }}</text>
        </div>
        <div class="user-info">
          <text class="user-name">{{ nickname || '未登录' }}</text>
          <text class="user-desc">{{ nickname ? '点击管理账户' : '点击头像登录' }}</text>
        </div>
      </div>
    </div>

    <!-- 菜单列表 -->
    <div class="menu-list">
      <div class="menu-item" onclick="goProfileDetail">
        <text class="menu-icon">📋</text>
        <text class="menu-text">用户档案</text>
        <text class="menu-arrow">›</text>
      </div>
      <div class="menu-item" onclick="goFamily">
        <text class="menu-icon">🏠</text>
        <text class="menu-text">我的家庭组</text>
        <text class="menu-arrow">›</text>
      </div>
      <div class="menu-item" onclick="showSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </div>
      <div class="menu-item" onclick="showAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </div>
      <div class="menu-item" onclick="showHelp">
        <text class="menu-icon">❓</text>
        <text class="menu-text">帮助与反馈</text>
        <text class="menu-arrow">›</text>
      </div>
    </div>

    <!-- ===== 用户面板（底部弹出） ===== -->
    <div class="panel-overlay" if="showPanel" onclick="closePanel"></div>
    <div class="user-panel {{ showPanel ? 'panel-show' : '' }}">
      <!-- 面板头部 -->
      <div class="panel-header">
        <text class="panel-title">{{ isLoggedIn ? '账户管理' : '登录 / 注册' }}</text>
        <div class="panel-close" onclick="closePanel">
          <text class="panel-close-text">✕</text>
        </div>
      </div>

      <!-- 未登录：登录 / 注册 -->
      <div class="panel-body" if="!isLoggedIn">
        <!-- 模式切换标签 -->
        <div class="panel-tabs">
          <div class="panel-tab {{ authMode === 'login' ? 'panel-tab-active' : '' }}" onclick="switchAuthMode('login')">
            <text class="panel-tab-text">登录</text>
          </div>
          <div class="panel-tab {{ authMode === 'register' ? 'panel-tab-active' : '' }}" onclick="switchAuthMode('register')">
            <text class="panel-tab-text">注册</text>
          </div>
        </div>

        <!-- 用户名 -->
        <input
          class="panel-input"
          type="text"
          placeholder="用户名"
          value="{{ authUsername }}"
          onchange="onAuthUsernameInput"
        />

        <!-- 密码 -->
        <input
          class="panel-input"
          type="password"
          placeholder="密码"
          value="{{ authPassword }}"
          onchange="onAuthPasswordInput"
        />

        <!-- 昵称（仅注册时显示） -->
        <input
          class="panel-input"
          type="text"
          placeholder="昵称"
          value="{{ authNickname }}"
          onchange="onAuthNicknameInput"
          if="{{ authMode === 'register' }}"
        />

        <!-- 操作按钮 -->
        <div class="panel-btn panel-btn-primary" onclick="doAuth">
          <text class="panel-btn-text">{{ authLoading ? '处理中...' : (authMode === 'login' ? '登录' : '注册') }}</text>
        </div>
      </div>

      <!-- 已登录：修改昵称 + 退出登录 -->
      <div class="panel-body" else>
        <!-- 当前信息 -->
        <div class="panel-current">
          <text class="panel-current-label">当前昵称</text>
          <text class="panel-current-value">{{ nickname }}</text>
        </div>

        <!-- 修改昵称 -->
        <text class="panel-section-title">修改昵称</text>
        <input
          class="panel-input"
          type="text"
          placeholder="输入新昵称"
          value="{{ editNickname }}"
          onchange="onEditNickInput"
        />
        <div class="panel-btn panel-btn-primary" onclick="doUpdateNickname">
          <text class="panel-btn-text">{{ saving ? '保存中...' : '确认修改' }}</text>
        </div>

        <!-- 分隔线 -->
        <div class="panel-divider"></div>

        <!-- 退出登录 -->
        <div class="panel-btn panel-btn-danger" onclick="doLogout">
          <text class="panel-btn-text">退出登录</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import $utils from '../../helper/utils'
import userIdentity from '../../helper/userIdentity'
import authAPI from '../../helper/apis/auth'
import familyAPI from '../../helper/apis/family'
import { safePush } from '../../helper/navigate'

export default {
  props: {},

  data: {
    nickname: '',
    isLoggedIn: false,
    newNickname: '',
    familyInfo: '',

    // 用户面板
    showPanel: false,

    // 认证模式：login | register
    authMode: 'login',
    authUsername: '',
    authPassword: '',
    authNickname: '',
    authLoading: false,

    // 修改昵称
    editNickname: '',
    saving: false,
  },

  computed: {
    avatarChar() {
      const name = (typeof this.nickname === 'string') ? this.nickname : ''
      return name ? name.charAt(0).toUpperCase() : '?'
    }
  },

  async onInit() {
    this.nickname = ''
    this.isLoggedIn = false
    this.showPanel = false
    this.saving = false
    await userIdentity.initUserId()
    await userIdentity.initNickname()
    await userIdentity.initLogin()
    this.nickname = userIdentity.getNickname()
    this.isLoggedIn = userIdentity.isLoggedIn()
  },

  refresh() {
    this.nickname = userIdentity.getNickname()
    this.isLoggedIn = userIdentity.isLoggedIn()
  },

  // ==================== 面板控制 ====================

  showUserPanel() {
    if (!this.isLoggedIn) {
      this.authMode = 'login'
      this.authUsername = ''
      this.authPassword = ''
      this.authNickname = ''
    } else {
      this.editNickname = this.nickname
    }
    this.showPanel = true
  },

  closePanel() {
    this.showPanel = false
    this.authUsername = ''
    this.authPassword = ''
    this.authNickname = ''
    this.editNickname = ''
  },

  // ==================== 认证模式切换 ====================

  switchAuthMode(mode) {
    this.authMode = mode
  },

  // ==================== 认证输入 ====================

  onAuthUsernameInput(e) {
    this.authUsername = e.value || e.text || ''
  },

  onAuthPasswordInput(e) {
    this.authPassword = e.value || e.text || ''
  },

  onAuthNicknameInput(e) {
    this.authNickname = e.value || e.text || ''
  },

  // ==================== 登录 / 注册 ====================

  async doAuth() {
    const username = (this.authUsername || '').trim()
    const password = (this.authPassword || '').trim()
    const nickname = (this.authNickname || '').trim()

    if (!username) {
      $utils.showToast('请输入用户名')
      return
    }
    if (!password) {
      $utils.showToast('请输入密码')
      return
    }
    if (this.authMode === 'register' && !nickname) {
      $utils.showToast('请输入昵称')
      return
    }
    if (this.authLoading) return

    this.authLoading = true
    try {
      if (this.authMode === 'login') {
        const res = await authAPI.login(username, password)
        userIdentity.setUserId(res.user_id)
        userIdentity.setNickname(res.nickname)
        userIdentity.markLoggedIn()
        this.nickname = res.nickname
        this.isLoggedIn = true
        this.showPanel = false
        $utils.showToast('登录成功！')
      } else {
        const res = await authAPI.register(username, password, nickname)
        userIdentity.setUserId(res.user_id)
        userIdentity.setNickname(res.nickname)
        userIdentity.markLoggedIn()
        this.nickname = res.nickname
        this.isLoggedIn = true
        this.showPanel = false
        $utils.showToast('注册成功！')
      }
    } catch (e) {
      const msg = (e && (e.message || e.detail || '')) || ''
      if (msg.includes('409') || msg.includes('已被注册')) {
        $utils.showToast('用户名已被注册')
      } else if (msg.includes('401') || msg.includes('错误')) {
        $utils.showToast('用户名或密码错误')
      } else {
        $utils.showToast('操作失败，请重试')
      }
    } finally {
      this.authLoading = false
    }
  },

  // ==================== 修改昵称 ====================

  onEditNickInput(e) {
    this.editNickname = e.value || e.text || ''
  },

  async doUpdateNickname() {
    const trimmed = (this.editNickname || '').trim()
    if (!trimmed) {
      $utils.showToast('昵称不能为空')
      return
    }
    if (trimmed === this.nickname) {
      $utils.showToast('昵称未变化')
      return
    }
    if (this.saving) return
    this.saving = true
    try {
      await familyAPI.register(trimmed)
      userIdentity.setNickname(trimmed)
      this.nickname = trimmed
      this.showPanel = false
      $utils.showToast('昵称已更新')
    } catch (e) {
      $utils.showToast('保存失败，请重试')
    } finally {
      this.saving = false
    }
  },

  // ==================== 退出登录 ====================

  doLogout() {
    userIdentity.setNickname('')
    userIdentity.markLoggedOut()
    this.nickname = ''
    this.isLoggedIn = false
    this.showPanel = false
    $utils.showToast('已退出登录')
  },

  // ==================== 路由 ====================

  goProfileDetail() {
    safePush('/pages/ProfileDetail')
  },

  goFamily() {
    safePush('/pages/Family')
  },

  showSettings() {
    safePush('/pages/Settings')
  },

  showAbout() {
    safePush('/pages/About')
  },

  showHelp() {
    safePush('/pages/Help')
  },
}
</script>

<style lang="less">
