  flex-direction: column;
  padding: 0 30px;
}

/* 认证模式标签 */
.panel-tabs {
  flex-direction: row;
  margin-bottom: 20px;
  border-radius: 12px;
  background-color: #f0e8dd;
  padding: 4px;
}

.panel-tab {
  flex: 1;
  height: 64px;
  border-radius: 10px;
  align-items: center;
  justify-content: center;
}

.panel-tab-active {
  background-color: #ffffff;
}

.panel-tab-text {
  font-size: 28px;
