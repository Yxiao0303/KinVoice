<template>
  <div class="page">
    <!-- 自定义标题栏 -->
    <div class="title-bar">
      <div class="title-left" onclick="goBack">
        <text class="back-arrow">‹</text>
      </div>
      <text class="title-text">用户档案</text>
      <div class="title-right" onclick="toggleMode">
        <text class="mode-icon">{{ isEditMode ? '📖' : '✏️' }}</text>
      </div>
    </div>

    <!-- 加载中 -->
    <div class="loading-wrap" if="loading">
      <text class="loading-text">加载中...</text>
    </div>

    <!-- ===== 阅读模式 ===== -->
    <div class="read-area" elif="!isEditMode">
      <!-- 空状态 -->
      <div class="empty" if="!content">
        <text class="empty-icon">📋</text>
        <text class="empty-title">还没有用户档案</text>
        <text class="empty-hint">点击右上角 ✏️ 来创建你的个人档案</text>
        <text class="empty-hint">支持 Markdown 格式记笔记</text>
      </div>
      <!-- 内容 -->
      <text class="md-content" else>{{ content }}</text>
    </div>

    <!-- ===== 编辑模式 ===== -->
    <div class="edit-area" else>
      <textarea class="editor" placeholder="在这里写下你的个人档案，支持 Markdown 格式..." onchange="onEditorChange">{{ editText }}</textarea>
      <div class="editor-tip">
        <text class="tip-text">支持：## 标题  **加粗**  *斜体*  - 列表  [链接]()</text>
      </div>
      <div class="editor-actions">
        <div class="btn btn-cancel" onclick="cancelEdit">
          <text class="btn-label">取消</text>
        </div>
        <div class="btn btn-save" onclick="saveProfile">
          <text class="btn-label">{{ saving ? '保存中...' : '保存' }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { safeBack } from '../../helper/navigate'
import profilesAPI from '../../helper/apis/profiles'
import userIdentity from '../../helper/userIdentity'
import $utils from '../../helper/utils'

export default {
  private: {
    isEditMode: false,
    content: '',
    editText: '',
    profileId: null,       // family_members 表的 id，null 表示还没创建
    loading: false,        // 初始不显示加载，由 loadProfile 控制
    saving: false,
  },

  async onInit() {
    this.$page.setTitleBar({ text: '', menu: false })
    // 先确保身份就绪（与其他模块保持一致的调用模式）
    await userIdentity.initUserId()
    await userIdentity.initNickname()
    await this.loadProfile()
  },

  onShow() {
    // 每次回来刷新（可能从 Companion 页面 AI 更新触发）
    if (!this.loading) {
      this.loadProfile()
    }
  },

  // ==================== 数据 ====================

  async loadProfile() {
    if (this.loading) return  // 防止重复加载
    this.loading = true
    try {
      const data = await profilesAPI.mine()
      // data 可能是 { id: 0, ... }（不存在）或 { id: 123, ... }
      if (data && data.id && data.id > 0) {
        this.profileId = data.id
        this.content = data.content_md || ''
      } else {
        this.profileId = null
        this.content = ''
      }
    } catch (e) {
      console.log('ProfileDetail 加载失败:', e)
    } finally {
      this.loading = false
    }
  },

  // ==================== 模式切换 ====================

  toggleMode() {
    if (this.isEditMode) {
      // 切回阅读
      this.isEditMode = false
      this.editText = ''
    } else {
      // 进入编辑
      this.editText = this.content || ''
      this.isEditMode = true
    }
  },

  cancelEdit() {
    this.editText = ''
    this.isEditMode = false
  },

  onEditorChange(e) {
    this.editText = e.value || e.text || ''
  },

  // ==================== 保存 ====================

  async saveProfile() {
    if (this.saving) return
    const trimmed = (this.editText || '').trim()
    this.saving = true
    try {
      if (this.profileId) {
        // 已有档案 → 更新
        await profilesAPI.update(this.profileId, {
          content_md: trimmed,
        })
      } else {
        // 首次创建 → 创建
        const data = await profilesAPI.create({
          content_md: trimmed,
        })
        if (data && data.id) {
          this.profileId = data.id
        }
      }
      this.content = trimmed
      this.isEditMode = false
      this.editText = ''
      $utils.showToast('✅ 档案已保存')
    } catch (e) {
      console.log('保存失败:', e)
      $utils.showToast('保存失败，请重试')
    } finally {
      this.saving = false
    }
  },

  // ==================== 返回 ====================

  goBack() {
    safeBack()
  },
}
</script>

