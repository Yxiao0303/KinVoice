  width: 70px;
  height: 70px;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 50px;
  color: #d4874b;
  font-weight: 300;
}

.title-text {
  font-size: 34px;
  font-weight: 600;
  color: #4a3728;
}

.title-right {
  width: 70px;
  height: 70px;
}

.card {
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 16px;
  padding: 30px 24px;
  margin: 24px;
}

.card {
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 16px;
  padding: 30px 24px;
}

.card-title {
  font-size: 32px;
  font-weight: 600;
  color: #4a3728;
  margin-bottom: 8px;
}

.card-desc {
  font-size: 26px;
  color: #9a8b7a;
  margin-bottom: 24px;
}

.form-group {
  flex-direction: column;
  margin-bottom: 20px;
}

.form-label {
  font-size: 26px;
  color: #9a8b7a;
  margin-bottom: 8px;
}

.form-input {
  height: 64px;
  border: 1px solid #d4c8b8;
  border-radius: 12px;
  padding: 0 16px;
  font-size: 30px;
  color: #4a3728;
  letter-spacing: 4px;
}

.join-btn {
  background-color: #d4874b;
  border-radius: 16px;
  padding: 22px;
  align-items: center;
  margin-top: 12px;
}

.join-btn-text {
  font-size: 30px;
  color: #ffffff;
  font-weight: 600;
}
</style>
