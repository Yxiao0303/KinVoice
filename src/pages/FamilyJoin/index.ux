<template>
  <div class="page">
    <!-- 自定义标题栏 -->
    <div class="title-bar">
      <div class="title-left" onclick="goBack">
        <text class="back-arrow">‹</text>
      </div>
      <text class="title-text">加入家庭组</text>
      <div class="title-right"></div>
    </div>

    <div class="card">
      <text class="card-desc">输入家人分享给你的家庭组 ID 和密码</text>

      <!-- 未登录：需要先注册 -->
      <block if="!isLoggedIn">
        <text class="form-label">用户名</text>
        <input class="form-input" type="text" placeholder="设置用户名" value="{{ authUsername }}" onchange="onAuthUsernameChange" />

        <text class="form-label">密码</text>
        <input class="form-input" type="password" placeholder="设置密码" value="{{ authPassword }}" onchange="onAuthPasswordChange" />

        <text class="form-label">昵称</text>
        <input class="form-input" type="text" placeholder="输入昵称" value="{{ nickname }}" onchange="onNicknameChange" />
      </block>

      <!-- 家庭组 ID -->
      <div class="form-group">
        <text class="form-label">家庭组 ID</text>
        <input class="form-input" type="text" placeholder="8位字母数字" maxlength="8" value="{{ familyIdInput }}" onchange="onFamilyIdChange" />
      </div>

      <!-- 密码 -->
      <div class="form-group">
        <text class="form-label">访问密码</text>
        <input class="form-input" type="password" placeholder="6位数字密码" maxlength="6" value="{{ passwordInput }}" onchange="onPasswordChange" />
      </div>

      <div class="join-btn" onclick="handleJoin">
        <text class="join-btn-text">{{ joining ? '加入中...' : '加入家庭组' }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import $utils from '../../helper/utils'
import userIdentity from '../../helper/userIdentity'
import authAPI from '../../helper/apis/auth'
import familyAPI from '../../helper/apis/family'
import { safeBack } from '../../helper/navigate'

export default {
  private: {
    isLoggedIn: false,
    nickname: '',
    authUsername: '',
    authPassword: '',
    familyIdInput: '',
    passwordInput: '',
    joining: false,
  },

  async onInit() {
    this.$page.setTitleBar({ text: '', menu: false })
    await userIdentity.initUserId()
    await userIdentity.initNickname()
    await userIdentity.initLogin()
    this.isLoggedIn = userIdentity.isLoggedIn()
    this.nickname = userIdentity.getNickname()
  },

  goBack() {
    safeBack()
  },

  onNicknameChange(e) {
    this.nickname = e.value || e.text || ''
  },

  onAuthUsernameChange(e) {
    this.authUsername = e.value || e.text || ''
  },

  onAuthPasswordChange(e) {
    this.authPassword = e.value || e.text || ''
  },

  onFamilyIdChange(e) {
    this.familyIdInput = (e.value || e.text || '').toUpperCase()
  },

  onPasswordChange(e) {
    this.passwordInput = e.value || e.text || ''
  },

  async handleJoin() {
    // 校验家庭组 ID
    if (!this.familyIdInput || this.familyIdInput.length !== 8) {
      $utils.showToast('请输入8位家庭组 ID')
      return
    }

    // 校验密码
    if (!this.passwordInput || this.passwordInput.length !== 6) {
      $utils.showToast('请输入6位密码')
      return
    }

    this.joining = true
    try {
      if (!this.isLoggedIn) {
        // 先注册新账号
        const username = (this.authUsername || '').trim()
        const password = (this.authPassword || '').trim()
        const nickname = (this.nickname || '').trim()
        if (!username) { $utils.showToast('请输入用户名'); return }
        if (!password) { $utils.showToast('请输入密码'); return }
        if (!nickname) { $utils.showToast('请输入昵称'); return }

        const res = await authAPI.register(username, password, nickname)
        userIdentity.setUserId(res.user_id)
        userIdentity.setNickname(res.nickname)
        userIdentity.markLoggedIn()
        this.isLoggedIn = true
        this.nickname = res.nickname
      }

      // 加入家庭组
      await familyAPI.joinGroup(
        this.familyIdInput,
        this.passwordInput,
        this.nickname || userIdentity.getNickname(),
      )

      $utils.showToast('加入成功！')
      this.$app && this.$app.back && this.$app.back()
    } catch (e) {
      const msg = (e && e.detail) || (e && e.message) || '加入失败，请检查 ID 和密码'
      $utils.showToast(msg)
    } finally {
      this.joining = false
    }
  },
}
</script>

