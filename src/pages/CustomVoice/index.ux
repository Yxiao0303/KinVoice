<template>
  <div class="page">
    <div class="header" onclick="goBack">
      <text class="back-icon">‹</text>
      <text class="title">自定义音色</text>
    </div>

    <div class="sample-box">
      <text class="sample-label">朗读下面这句话：</text>
      <text class="sample-text">{{ sampleText }}</text>
    </div>

    <div class="action-area">
      <div class="btn" onclick="handleRecord">
        <text class="btn-text">🎙️ 开始录音</text>
      </div>
    </div>

    <div class="tip-box">
      <text class="tip-text">录音功能需要真机环境，模拟器暂不支持</text>
    </div>
  </div>
</template>

<script>
import replica from '../../helper/apis/replica'
import $utils from '../../helper/utils'
import { safeBack } from '../../helper/navigate'

export default {
  private: {
    sampleText: '欢迎来到情绪树洞',
  },

  async onInit() {
    this.$page.setTitleBar({ text: '', menu: false })
    try {
      const res = await replica.getSampleTexts()
      if (res && res.samples && res.samples.length > 0) {
        this.sampleText = res.samples[0]
      }
    } catch (e) {
      console.log('获取示例文本失败:', e)
    }
  },

  handleRecord() {
    $utils.showToast('录音功能需真机调试')
  },

  goBack() {
    safeBack()
  }
}
</script>

